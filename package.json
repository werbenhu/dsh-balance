{
  "name": "dsh-balance-panel",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness 插件：为每个模型供应商选择余额查询方式，菜单栏入口 + 右侧抽屉查看各家套餐余额与配额。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0"
  },
  "scripts": {
    "test": "node --test test/adapters.test.mjs test/plugin.test.mjs test/client.test.mjs test/xai.test.mjs test/proxy.test.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "balance",
    "quota",
    "coding-plan"
  ],
  "license": "MIT",
  "dependencies": {
    "undici": "^8.12.3"
  }
}
